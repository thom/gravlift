    echo "Official downloads: https://antigravity.google/download"
    echo
    echo "Commands:"
    echo "  install [archive.tar.gz]   Install Antigravity 2.0 from an archive (or auto-scan)"
    echo "  update                     Scan download directories and install available updates"
    echo "  self-install               Install gravlift to ~/opt/gravlift and link to user bin"
    echo "  uninstall [target]         Uninstall Antigravity (app), gravlift (self), or both (all)"
    echo "  check                      Run pre-flight diagnostic checks (glibc, disk space, PATH)"
    echo "  version                    Display gravlift script version"
    echo "  help [command]             Show help documentation for gravlift or a command"
    echo
    echo "Global Options:"
    echo "  -h, --help                 Show this help message"
    echo "  -v, --version              Show script version"
    echo "  --dry-run                  Simulate actions without modifying files"
    echo "  --bin-dir <dir>            Override user bin directory (default: ~/.local/bin)"
    echo "  --self-install-dir <dir>   Override self-install directory (default: ~/opt/gravlift)"
    echo
    echo "Legacy Compatibility:"
    echo "  Direct invocations and legacy flags (e.g. '$(basename "$0") archive.tar.gz',"
    echo "  '--self-install', '--uninstall', '--dry-run') are fully supported."
    echo
    echo "Run '$(basename "$0") help <command>' for detailed options on a specific command."
}

