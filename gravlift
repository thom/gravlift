            echo "Usage: $(basename "$0") install [options] [archive.tar.gz]"
            echo
            echo "Install Antigravity 2.0 from a .tar.gz archive. If no archive is specified,"
            echo "scans the current directory and your configured Downloads directory."
            echo
            echo "Options:"
            echo "  --dry-run                 Simulate installation without modifying files"
            echo "  --skip-backup             Skip creating a backup of existing installations"
            echo "  --force                   Force installation even if archive version is not newer"
            echo "  --no-self-install         Do not install/update gravlift itself during installation"
            echo "  --bin-dir <dir>           Override user bin directory (default: ~/.local/bin)"
            ;;
        update)
            echo "Usage: $(basename "$0") update [options]"
            echo
            echo "Scan the current directory and your configured Downloads directory for newer"
            echo "Antigravity 2.0 releases and install them automatically."
            echo
            echo "Options:"
            echo "  --dry-run                 Simulate update without modifying files"
            echo "  --skip-backup             Skip creating a backup of existing installations"
            echo "  --force                   Force installation even if archive version is not newer"
            echo "  --no-self-install         Do not install/update gravlift itself during installation"
            echo "  --bin-dir <dir>           Override user bin directory (default: ~/.local/bin)"
            ;;
        self-install)
            echo "Usage: $(basename "$0") self-install [options]"
            echo
            echo "Install the gravlift script to ~/opt/gravlift and symlink to user bin directory."
            echo
            echo "Options:"
            echo "  --dry-run                 Simulate self-installation without modifying files"
            echo "  --self-install-dir <dir>  Override self-install directory (default: ~/opt/gravlift)"
            echo "  --bin-dir <dir>           Override user bin directory (default: ~/.local/bin)"
            ;;
        uninstall)
            echo "Usage: $(basename "$0") uninstall [target] [options]"
            echo
            echo "Uninstall Antigravity 2.0, the gravlift tool, or everything."
            echo
            echo "Targets:"
            echo "  app                       Uninstall Antigravity 2.0 application (default)"
            echo "  self                      Uninstall the gravlift tool itself"
            echo "  all                       Uninstall Antigravity 2.0, gravlift, and related files"
            echo
            echo "Options:"
            echo "  --dry-run                 Simulate uninstallation without removing files"
            echo "  --purge                   Purge backups and config files during uninstallation"
            echo "  -y, --yes                 Bypass confirmation prompts (for non-interactive use)"
            echo "  --bin-dir <dir>           Override user bin directory (default: ~/.local/bin)"
            echo "  --self-install-dir <dir>  Override self-install directory (default: ~/opt/gravlift)"
            ;;
        check)
            echo "Usage: $(basename "$0") check [options]"
            echo
            echo "Perform pre-flight diagnostics including glibc compatibility, required tools,"
            echo "target partition disk space, and PATH environment configuration."
            echo
            echo "Options:"
            echo "  --bin-dir <dir>           Override user bin directory to check (default: ~/.local/bin)"
            ;;
        version)
            echo "Usage: $(basename "$0") version"
            echo
            echo "Display the gravlift script version."
            ;;
        help)
            echo "Usage: $(basename "$0") help [command]"
            echo
            echo "Show general help or detailed help for a specific command."
            ;;
        *)
            print_usage
            ;;
    esac
}

# Logger utilities
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Dependency check
check_dependencies() {
    local missing=()
    for cmd in tar find cut uniq mktemp ln rm cp realpath; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done
    if [ ${#missing[@]} -ne 0 ]; then
        log_error "Missing required command dependencies: ${missing[*]}"
        exit 1
    fi
}

# Detect Antigravity 2.0 inside a tarball by inspecting archive contents
detect_app_type() {
    local tarball="$1"
    
    local contents
    if contents=$(tar -tf "$tarball" 2>/dev/null); then
        if echo "$contents" | grep -qE "(^|/)antigravity$"; then
            echo "antigravity"
            return 0
        fi
    fi

    echo "unknown"
    return 0
}

# Search for a suitable icon file in the app directory
find_app_icon() {
    local dir="$1"
    local app_name="$2"
    local alt_name="$3"
    local icon_path=""

    # Helper function to find files excluding dependency folders (node_modules, extensions)
    find_pruned() {
        local search_dir="$1"
        local pat1="$2"
        local pat2="$3"
        find "$search_dir" \
            -path "*/node_modules" -prune \
            -o -path "*/extensions" -prune \
            -o -type f \( -name "$pat1" -o -name "$pat2" \) -print -quit
    }

    # 1. Search for PNG/SVG files with the app name (excluding node_modules/extensions)
    icon_path=$(find_pruned "$dir" "*${app_name}*.png" "*${app_name}*.svg")
    
    # 2. Search for PNG/SVG files with the alt name (e.g. code) (excluding node_modules/extensions)
    if [ -z "$icon_path" ] && [ -n "$alt_name" ]; then
        icon_path=$(find_pruned "$dir" "*${alt_name}*.png" "*${alt_name}*.svg")
    fi

    # 3. Search for generic icon/logo names (excluding node_modules/extensions)
    if [ -z "$icon_path" ]; then
        icon_path=$(find_pruned "$dir" "*icon*.png" "*icon*.svg")
    fi
    if [ -z "$icon_path" ]; then
        icon_path=$(find_pruned "$dir" "*logo*.png" "*logo*.svg")
    fi

    # 4. Search for any PNG/SVG files inside resources folder
    if [ -z "$icon_path" ] && [ -d "$dir/resources" ]; then
        icon_path=$(find "$dir/resources" -type f \( -name "*.png" -o -name "*.svg" \) -print -quit)
    fi

    # 5. Search for any PNG/SVG files in the entire target directory (excluding node_modules/extensions)
    if [ -z "$icon_path" ]; then
        icon_path=$(find_pruned "$dir" "*.png" "*.svg")
    fi

    echo "$icon_path"
}

# Create desktop file
create_desktop_launcher() {
    local app_dir="$1"
    local exec_path="$2"
    local icon_path="$3"
    local icon_name="antigravity"

    mkdir -p "$DESKTOP_DIR"
    local local_icon_dir="$HOME/.local/share/icons"

    if [ -n "$icon_path" ] && [ -f "$icon_path" ]; then
        mkdir -p "$local_icon_dir"
        local filename
        filename=$(basename "$icon_path")
        local ext=""
        if [[ "$filename" == *.* ]]; then
            ext="${filename##*.}"
        fi
        
        local dest_icon
        if [ -n "$ext" ]; then
            dest_icon="$local_icon_dir/$icon_name.$ext"
        else
            dest_icon="$local_icon_dir/$icon_name.png"
        fi
        cp "$icon_path" "$dest_icon"
        log_success "Installed application icon: $dest_icon"
    else
        # Fallback icon name if no custom icon found
        icon_name="system-run"
    fi

    local desktop_file="$DESKTOP_DIR/antigravity.desktop"
    log_info "Creating desktop launcher: $desktop_file"
    cat > "$desktop_file" <<EOF
[Desktop Entry]
Name=Antigravity 2.0
Comment=Google Antigravity Agent Orchestrator
Exec="$exec_path" %U
Terminal=false
Type=Application
Icon=$icon_name
Categories=Development;
StartupNotify=true
StartupWMClass=Antigravity
EOF
    log_success "Created desktop launcher: $desktop_file"
    
    # Update GNOME desktop entry database
    if command -v update-desktop-database &>/dev/null; then
        update-desktop-database "$DESKTOP_DIR" || true
    fi
}

# Returns 0 if $1 <= $2, 1 otherwise (semantic version comparison using sort -V -C)
version_le() {
    printf '%s\n%s\n' "$1" "$2" | sort -V -C
}

# Extract GRAVLIFT_VERSION from a script file, defaulting to 0.0.0 if not found
get_gravlift_version() {
    local script_path="$1"
    local ver=""
    if [ -f "$script_path" ]; then
        ver=$(sed -n 's/^GRAVLIFT_VERSION="\([^"]*\)"/\1/p' "$script_path" 2>/dev/null)
    fi
    echo "${ver:-0.0.0}"
}

# Get application version from package.json or product.json in target directory
get_app_version() {
    local app_dir="$1"
    local app_type="$2"
    local exe_name="$3"
    
    local pkg_json=""
    
    # 1. Search for package.json or product.json in standard locations
    if [ -f "$app_dir/resources/app/package.json" ]; then
        pkg_json="$app_dir/resources/app/package.json"
    elif [ -f "$app_dir/resources/app/product.json" ]; then
        pkg_json="$app_dir/resources/app/product.json"
    fi
    
    if [ -n "$pkg_json" ]; then
        # Extract version using sed (portable, avoids pipefail/SIGPIPE issues)
        sed -n '/"version":/ { s/.*"version":\s*"//; s/".*//; p; q; }' "$pkg_json" || echo "0.0.0"
    else
        # 2. Try executing the binary inside Electron's Node environment to read package.json inside app.asar
        local exe_path="$app_dir/$exe_name"
        if [ -f "$exe_path" ]; then
            local ver
            ver=$(ELECTRON_RUN_AS_NODE=true "$exe_path" -e "
                try {
                    console.log(require(process.argv[1]).version);
                } catch(e) {
                    try {
                        console.log(require(process.argv[2]).version);
                    } catch(err) {
                        console.log('0.0.0');
                    }
                }
            " "$app_dir/resources/app.asar/package.json" "$app_dir/resources/app/package.json" 2>/dev/null) || ver="0.0.0"
            echo "${ver:-0.0.0}"
        else
            echo "0.0.0"
        fi
    fi
}

# Perform installation for a single archive
install_archive() {
    local tarball="$1"
    local dry_run="$2"
    local skip_backup="$3"
    local force="$4"

    if [ ! -f "$tarball" ]; then
        log_error "Archive file not found: $tarball"
        return 1
    fi

    log_info "Analyzing archive: $(basename "$tarball")..."
    local app_type
    app_type=$(detect_app_type "$tarball")

    if [ "$app_type" != "antigravity" ]; then
        log_error "Could not detect Antigravity 2.0 inside archive: $(basename "$tarball")"
        log_info "Make sure the file is an Antigravity 2.0 Linux archive."
        log_info "Official downloads: https://antigravity.google/download"
        return 1
    fi

    local app_label="Antigravity 2.0"
    local folder_name="antigravity"
    local exec_name="antigravity"

    log_info "Detected application: ${BOLD}$app_label${NC}"

    local target_dir="$INSTALL_PARENT/$folder_name"
    local bin_link="$BIN_DIR/$exec_name"

    # --- Dry Run Short Circuit ---
    if [ "$dry_run" = "true" ]; then
        log_info "[DRY-RUN] Would extract $(basename "$tarball"), compare versions, backup, clean, and install to $target_dir"
        log_info "[DRY-RUN] Would symlink $target_dir/$exec_name -> $bin_link"
        log_info "[DRY-RUN] Would generate GNOME desktop entry."
        log_info "[DRY-RUN] Would install 'gravlift' management tool to $SELF_INSTALL_DIR and link to $BIN_DIR/gravlift"
        return 0
    fi

    # --- 1. Extract to Temporary Folder for Analysis ---
    log_info "Extracting archive contents to temporary directory..."
    local temp_extract_dir
    temp_extract_dir=$(mktemp -d)
    register_temp_dir "$temp_extract_dir"
    
    # Disable error exit momentarily to clean up properly if extraction fails
    set +e
    tar -xzf "$tarball" -C "$temp_extract_dir"
    local extract_exit=$?
    set -e
    
    if [ $extract_exit -ne 0 ]; then
        log_error "Failed to extract tarball archive."
        rm -rf "$temp_extract_dir"
        return 1
    fi

    # Find the actual executable location in the extracted files (picking the shallowest path to avoid bin/ scripts)
    local found_exe=""
    local min_depth=999
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local slashes="${line//[^\/]}"
        local depth="${#slashes}"
        if [ "$depth" -lt "$min_depth" ]; then
            min_depth="$depth"
            found_exe="$line"
        fi
    done < <(find "$temp_extract_dir" -type f -name "$exec_name")
    
    if [ -z "$found_exe" ]; then
        log_error "Could not find the executable '$exec_name' inside the archive."
        rm -rf "$temp_extract_dir"
        return 1
    fi
    
    # Determine the root of the app inside the archive
    local app_src_root
    app_src_root=$(dirname "$found_exe")

    # --- 2. Version Comparison Check ---
    local new_version
    new_version=$(get_app_version "$app_src_root" "$app_type" "$exec_name")
    
    local installed_version="0.0.0"
    if [ -d "$target_dir" ]; then
        installed_version=$(get_app_version "$target_dir" "$app_type" "$exec_name")
    fi

    log_info "Archive version: ${BOLD}$new_version${NC}"
    if [ "$installed_version" != "0.0.0" ]; then
        log_info "Currently installed version: ${BOLD}$installed_version${NC}"
        
        if version_le "$new_version" "$installed_version"; then
            if [ "$force" = "true" ]; then
                log_warning "Archive version ($new_version) is not newer than installed version ($installed_version), but forcing installation as requested."
            else
                log_error "Archive version ($new_version) is not newer than installed version ($installed_version)."
                log_error "To overwrite, upgrade/downgrade anyway, run with the --force option."
                rm -rf "$temp_extract_dir"
                return 1
            fi
        fi
    fi

    # --- 3. Backup Existing Installation ---
    if [ -d "$target_dir" ] && [ "$skip_backup" = "false" ]; then
        local timestamp
        timestamp=$(date +%Y%m%d_%H%M%S)
        local backup_file="$BACKUP_DIR/${folder_name}_backup_${timestamp}.tar.gz"
        log_info "Existing installation found. Creating backup..."
        mkdir -p "$BACKUP_DIR"
        
        if tar -czf "$backup_file" -C "$INSTALL_PARENT" "$folder_name"; then
            log_success "Backup saved to: $backup_file"
        else
            log_warning "Failed to create backup, but proceeding with installation."
        fi
    fi

    # --- 4. Clean and Extract (Atomic Swap) ---
    local temp_target="${target_dir}.new"
    register_temp_dir "$temp_target"
    rm -rf "$temp_target"
    mkdir -p "$temp_target"

    log_info "Installing new version files..."
    # Move all files safely using POSIX-compatible find/exec sh
    find "$app_src_root" -mindepth 1 -maxdepth 1 -exec sh -c 'mv "$@" "$0"' "$temp_target" {} +
    
    # Clean up temporary extraction directory
    rm -rf "$temp_extract_dir"

    log_info "Replacing old installation with new version..."
    if [ -d "$target_dir" ]; then
        local old_target="${target_dir}.old"
        register_temp_dir "$old_target"
        rm -rf "$old_target"
        mv "$target_dir" "$old_target"
        mv "$temp_target" "$target_dir"
        rm -rf "$old_target"
    else
        mv "$temp_target" "$target_dir"
    fi
    log_success "Application files installed to: $target_dir"

    # --- 5. Symlinks ---
    log_info "Creating command-line symlink..."
    mkdir -p "$BIN_DIR"
    rm -f "$bin_link"
    ln -s "$target_dir/$exec_name" "$bin_link"
    log_success "Symlink created at: $bin_link"

    # --- 6. Icons and Desktop Launcher ---
    local icon_path=""
    icon_path=$(find_app_icon "$target_dir" "$exec_name" "code")
    
    if [ -z "$icon_path" ]; then
        # Check if we can extract it from app.asar (for packaged Electron apps)
        local asar_file="$target_dir/resources/app.asar"
        if [ -f "$asar_file" ]; then
            local local_icon_dir="$HOME/.local/share/icons"
            mkdir -p "$local_icon_dir"
            log_info "Icon not found on disk. Extracting icon.png from app.asar..."
            
            ELECTRON_RUN_AS_NODE=true "$target_dir/$exec_name" -e "
                const fs = require('fs');
                try {
                    fs.copyFileSync(process.argv[1], process.argv[2]);
                    console.log('SUCCESS');
                } catch(e) {}
            " "$asar_file" "$local_icon_dir/antigravity.png" &>/dev/null || true
            
            if [ -f "$local_icon_dir/antigravity.png" ]; then
                icon_path="$local_icon_dir/antigravity.png"
            fi
        fi
    fi

    if [ -n "$icon_path" ]; then
        log_info "Found application icon at: $icon_path"
    else
        log_warning "Could not find a suitable icon file. Using system default icon."
    fi
    create_desktop_launcher "$target_dir" "$bin_link" "$icon_path"

    log_success "$app_label installed/updated successfully!"
    echo "-------------------------------------------------"
}

# Verify Path
check_path() {
    if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
        log_warning "${BOLD}$BIN_DIR${NC} is not currently in your ${BOLD}\$PATH${NC}."
        echo "To run commands from $BIN_DIR in any terminal:"
        echo
        echo -e "For ${BOLD}bash${NC} or ${BOLD}zsh${NC}, add this to your config file (e.g. ~/.bashrc or ~/.zshrc):"
        echo -e "${YELLOW}  export PATH=\"$BIN_DIR:\$PATH\"${NC}"
        echo
        echo -e "For ${BOLD}fish${NC}, run this command once to persist the path dynamically:"
        echo -e "${YELLOW}  fish_add_path $BIN_DIR${NC}"
        echo "Or add this to ~/.config/fish/config.fish:"
        echo -e "${YELLOW}  set -gx PATH $BIN_DIR \$PATH${NC}"
        echo
    else
        log_success "$BIN_DIR is already in your \$PATH."
    fi
}

# Install this script itself to $SELF_INSTALL_DIR/gravlift and link to $BIN_DIR/gravlift
self_install() {
    local force="${1:-false}"
    local target_script="$SELF_INSTALL_DIR/gravlift"
    local symlink_path="$BIN_DIR/gravlift"

    mkdir -p "$SELF_INSTALL_DIR"
    mkdir -p "$BIN_DIR"

    local current_script_abs
    current_script_abs=$(realpath "$0")
    local target_script_abs=""
    if [ -f "$target_script" ]; then
        target_script_abs=$(realpath "$target_script")
    fi

    # Read installed version if target script exists
    local installed_version
    installed_version=$(get_gravlift_version "$target_script")

    if [ "$current_script_abs" != "$target_script_abs" ]; then
        if [ -f "$target_script" ]; then
            if version_le "$GRAVLIFT_VERSION" "$installed_version" && [ "$force" != "true" ]; then
                log_info "Installed gravlift is already up to date (v${installed_version})."
            else
                log_info "Upgrading installed gravlift (v${installed_version} -> v${GRAVLIFT_VERSION})..."
                cp "$0" "$target_script"
                chmod +x "$target_script"
                log_success "Script upgraded at: $target_script"
            fi
        else
            log_info "Installing 'gravlift' script to $SELF_INSTALL_DIR (v${GRAVLIFT_VERSION})..."
            cp "$0" "$target_script"
            chmod +x "$target_script"
            log_success "Script installed at: $target_script"
        fi
    fi

    # Create / update the symlink in BIN_DIR
    rm -f "$symlink_path"
    ln -s "$target_script" "$symlink_path"
    log_success "Symlink created: $symlink_path -> $target_script"
}

# Prompt user for confirmation unless bypassed (-y/--yes)
confirm_action() {
    local prompt="$1"
    local default="${2:-n}"

    if [ "${YES_MODE:-false}" = "true" ]; then
        return 0
    fi

    # Require -y/--yes if run in non-interactive environment
    if [ ! -t 0 ]; then
        log_error "Non-interactive environment detected. Use '-y' or '--yes' to confirm uninstallation."
        exit 1
    fi

    local response
    if [ "$default" = "y" ]; then
        echo -ne "${YELLOW}$prompt [Y/n]: ${NC}"
        read -r response
        response="${response:-y}"
    else
        echo -ne "${YELLOW}$prompt [y/N]: ${NC}"
        read -r response
        response="${response:-n}"
    fi

    if [[ "$response" =~ ^[Yy]$ ]]; then
        return 0
    fi
    return 1
}

# Validate that a path is safe for removal operations
verify_safe_path() {
    local target="$1"
    local expected_suffix="$2"
    local desc="$3"

    if [ -z "$target" ]; then
        log_error "Safety validation failed: $desc path is empty."
        return 1
    fi

    # Reject system root, standard parent dirs, and raw user home
    case "$target" in
        /|/home|/home/|/root|/usr|/bin|/sbin|/etc|/var|/opt|/tmp|"$HOME"|"$HOME/")
            log_error "Safety validation failed: Refusing to operate on critical system or home path '$target' ($desc)."
            return 1
            ;;
    esac

    # Ensure path contains expected suffix / name
    if [ -n "$expected_suffix" ]; then
        if [[ "$target" != *"$expected_suffix" ]]; then
            log_error "Safety validation failed: '$target' does not match expected suffix '$expected_suffix' ($desc)."
            return 1
        fi
    fi

    return 0
}

# Uninstall Antigravity 2.0 application files, symlinks, and desktop launcher
uninstall_antigravity() {
    local dry_run="${1:-false}"
    local purge="${2:-false}"
    local app_dir="$INSTALL_PARENT/antigravity"
    local bin_link="$BIN_DIR/antigravity"
    local desktop_file="$DESKTOP_DIR/antigravity.desktop"
    local icon_file="$HOME/.local/share/icons/antigravity.png"
    local lock_file="$INSTALL_PARENT/.antigravity.lock"

    # Strict safety validations before any checks or operations
    if ! verify_safe_path "$app_dir" "/antigravity" "Application Directory"; then
        return 1
    fi
    if ! verify_safe_path "$bin_link" "/antigravity" "Binary Symlink"; then
        return 1
    fi
    if ! verify_safe_path "$desktop_file" "antigravity.desktop" "Desktop Launcher"; then
        return 1
    fi
    if ! verify_safe_path "$icon_file" "antigravity.png" "Application Icon"; then
        return 1
    fi
    if [ "$purge" = "true" ]; then
        if ! verify_safe_path "$BACKUP_DIR" "backups" "Backup Directory"; then
            return 1
        fi
    fi

    log_info "Checking Antigravity 2.0 installation..."

    local found_any=false
    if [ -d "$app_dir" ] || [ -L "$bin_link" ] || [ -f "$bin_link" ] || [ -f "$desktop_file" ] || [ -f "$icon_file" ]; then
        found_any=true
    fi

    if [ "$found_any" = "false" ]; then
        log_warning "No Antigravity 2.0 installation found in standard locations."
        return 0
    fi

    if [ "$dry_run" = "true" ]; then
        log_info "[DRY-RUN] The following Antigravity items would be removed:"
        [ -d "$app_dir" ] && echo "  - Application Directory: $app_dir"
        { [ -e "$bin_link" ] || [ -L "$bin_link" ]; } && echo "  - Binary Symlink:       $bin_link"
        [ -f "$desktop_file" ] && echo "  - Desktop Launcher:     $desktop_file"
        [ -f "$icon_file" ] && echo "  - Application Icon:     $icon_file"
        if [ "$purge" = "true" ] && [ -d "$BACKUP_DIR" ]; then
            echo "  - Backup Cache:         $BACKUP_DIR"
        fi
        return 0
    fi

    if ! confirm_action "Are you sure you want to uninstall Antigravity 2.0?"; then
        log_info "Uninstallation canceled."
        return 0
    fi

    # Remove binary symlink
    if [ -e "$bin_link" ] || [ -L "$bin_link" ]; then
        rm -f "$bin_link"
        log_success "Removed binary symlink: $bin_link"
    fi

    # Remove desktop entry
    if [ -f "$desktop_file" ]; then
        rm -f "$desktop_file"
        log_success "Removed desktop launcher: $desktop_file"
    fi

    # Remove icon
    if [ -f "$icon_file" ]; then
        rm -f "$icon_file"
        log_success "Removed icon: $icon_file"
    fi

    # Update desktop database
    if command -v update-desktop-database &>/dev/null; then
        update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
    fi

    # Remove app directory
    if [ -d "$app_dir" ]; then
        rm -rf "$app_dir"
        log_success "Removed application directory: $app_dir"
    fi

    # Clean leftover lock file
    rm -f "$lock_file"

    # Purge backup cache if requested
    if [ "$purge" = "true" ] && [ -d "$BACKUP_DIR" ]; then
        rm -rf "$BACKUP_DIR"
        log_success "Removed backup directory: $BACKUP_DIR"
    fi

    log_success "Antigravity 2.0 uninstallation completed successfully."
}

# Uninstall gravlift executable and symlink
uninstall_self() {
    local dry_run="${1:-false}"
    local purge="${2:-false}"
    local script_target="$SELF_INSTALL_DIR/gravlift"
    local bin_link="$BIN_DIR/gravlift"
    local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/gravlift"

    # Strict safety validations before any checks or operations
    if ! verify_safe_path "$script_target" "/gravlift" "Script Executable"; then
        return 1
    fi
    if ! verify_safe_path "$bin_link" "/gravlift" "Binary Symlink"; then
        return 1
    fi
    if ! verify_safe_path "$SELF_INSTALL_DIR" "gravlift" "Self Install Directory"; then
        return 1
    fi
    if [ "$purge" = "true" ]; then
        if ! verify_safe_path "$config_dir" "gravlift" "Config Directory"; then
            return 1
        fi
    fi

    log_info "Checking gravlift installation..."

    local found_any=false
    if [ -f "$script_target" ] || [ -L "$bin_link" ] || [ -f "$bin_link" ]; then
        found_any=true
    fi

    if [ "$found_any" = "false" ]; then
        log_warning "No installed gravlift script found ($script_target, $bin_link)."
        return 0
    fi

    if [ "$dry_run" = "true" ]; then
        log_info "[DRY-RUN] The following gravlift items would be removed:"
        [ -f "$script_target" ] && echo "  - Installed Executable: $script_target"
        { [ -e "$bin_link" ] || [ -L "$bin_link" ]; } && echo "  - Binary Symlink:       $bin_link"
        if [ "$purge" = "true" ] && [ -d "$config_dir" ]; then
            echo "  - Config Directory:     $config_dir"
        fi
        return 0
    fi

    if ! confirm_action "Are you sure you want to uninstall the gravlift tool?"; then
        log_info "Uninstallation canceled."
        return 0
    fi

    if [ -e "$bin_link" ] || [ -L "$bin_link" ]; then
        rm -f "$bin_link"
        log_success "Removed binary symlink: $bin_link"
    fi

    if [ -f "$script_target" ]; then
        rm -f "$script_target"
        log_success "Removed script: $script_target"
    fi

    if [ -d "$SELF_INSTALL_DIR" ]; then
        rmdir "$SELF_INSTALL_DIR" 2>/dev/null || true
    fi

    if [ "$purge" = "true" ] && [ -d "$config_dir" ]; then
        rm -rf "$config_dir"
        log_success "Removed configuration directory: $config_dir"
    fi

    log_success "gravlift tool uninstallation completed successfully."
}

# Verify that the system glibc version meets requirements (>= 2.28)
check_glibc_version() {
    if ! command -v ldd &>/dev/null; then
        log_warning "Could not find 'ldd' to verify glibc compatibility."
        return 0
    fi
    
    local ldd_output
    ldd_output=$(ldd --version | head -n 1) || return 0
    
    # Extract version e.g. "2.35"
    local glibc_ver
    glibc_ver=$(echo "$ldd_output" | grep -oE '[0-9]+\.[0-9]+' | head -n 1) || return 0
    
    if [ -n "$glibc_ver" ]; then
        log_info "Detected system glibc version: ${BOLD}$glibc_ver${NC}"
        
        if version_le "$glibc_ver" "2.27"; then
            log_warning "Your system's glibc version ($glibc_ver) is below the recommended version (2.28)."
            log_warning "Antigravity applications may fail to launch at runtime."
            echo
        fi
    fi
}

# Pre-flight check: Verify available disk space in destination partition
check_disk_space() {
    local check_dir="$INSTALL_PARENT"
    # Find closest existing parent directory to check space on the correct partition
    while [ ! -d "$check_dir" ] && [ "$check_dir" != "/" ]; do
        check_dir=$(dirname "$check_dir")
    done
    
    if ! command -v df &>/dev/null; then
        log_warning "Could not find 'df' to verify available disk space."
        return 0
    fi

    local avail_kb
    avail_kb=$(df -Pk "$check_dir" 2>/dev/null | tail -n 1 | awk '{print $4}') || avail_kb=""
    
    if [ -n "$avail_kb" ]; then
        if [[ "$avail_kb" =~ ^[0-9]+$ ]]; then
            # Require at least 1GB (1048576 KB)
            local min_kb=1048576
            if [ "$avail_kb" -lt "$min_kb" ]; then
                log_error "Insufficient disk space on target partition containing $check_dir."
                log_error "Available: $((avail_kb / 1024)) MB, Required: 1024 MB."
                exit 1
            fi
            log_info "Disk space check passed: $((avail_kb / 1024)) MB available."
        else
            log_warning "Could not parse available disk space value: '$avail_kb'. Skipping space check."
        fi
    fi
}

# --- Subcommand Handlers ---

cmd_version() {
    echo "gravlift v${GRAVLIFT_VERSION}"
}

cmd_help() {
    if [ $# -gt 0 ]; then
        print_command_help "$1"
    else
        print_usage
    fi
}

cmd_check() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                print_command_help "check"
                return 0
                ;;
            --bin-dir)
                if [ -z "${2:-}" ]; then
                    log_error "Option $1 requires a directory path argument."
                    print_command_help "check"
                    exit 1
                fi
                CLI_BIN_DIR="$2"
                shift 2
                ;;
            -*)
                log_error "Unknown option for check: $1"
                print_command_help "check"
                exit 1
                ;;
            *)
                log_error "Unexpected argument for check: $1"
                print_command_help "check"
                exit 1
                ;;
        esac
    done

    BIN_DIR=$(resolve_bin_dir)
    SELF_INSTALL_DIR=$(resolve_self_install_dir)

    log_info "Running pre-flight diagnostics..."
    echo "================================================="
    check_dependencies
    log_success "All required system dependencies are installed."
    check_glibc_version
    check_disk_space
    check_path

    # Check installed gravlift version status
    local installed_tool="$SELF_INSTALL_DIR/gravlift"
    if [ -f "$installed_tool" ]; then
        local inst_ver
        inst_ver=$(get_gravlift_version "$installed_tool")
        if [ "$inst_ver" = "$GRAVLIFT_VERSION" ]; then
            log_success "Installed gravlift is up to date (v${inst_ver})."
        elif version_le "$inst_ver" "$GRAVLIFT_VERSION"; then
            log_warning "Installed gravlift (v${inst_ver}) is older than running script (v${GRAVLIFT_VERSION})."
            echo "Run '$(basename "$0") self-install' to update the installed tool."
        else
            log_info "Installed gravlift version: v${inst_ver}"
        fi
    fi

    log_success "Diagnostics completed."
}

cmd_self_install() {
    local dry_run="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                print_command_help "self-install"
                return 0
                ;;
            --dry-run)
                dry_run="true"
                shift
                ;;
            --self-install-dir)
                if [ -z "${2:-}" ]; then
                    log_error "Option $1 requires a directory path argument."
                    print_command_help "self-install"
                    exit 1
                fi
                CLI_SELF_INSTALL_DIR="$2"
                shift 2
                ;;
            --bin-dir)
                if [ -z "${2:-}" ]; then
                    log_error "Option $1 requires a directory path argument."
                    print_command_help "self-install"
                    exit 1
                fi
                CLI_BIN_DIR="$2"
                shift 2
                ;;
            -*)
                log_error "Unknown option for self-install: $1"
                print_command_help "self-install"
                exit 1
                ;;
            *)
                log_error "Unexpected argument for self-install: $1"
                print_command_help "self-install"
                exit 1
                ;;
        esac
    done

    BIN_DIR=$(resolve_bin_dir)
    SELF_INSTALL_DIR=$(resolve_self_install_dir)

    if [ "$dry_run" = "true" ]; then
        log_info "[DRY-RUN] Would install 'gravlift' script to $SELF_INSTALL_DIR/gravlift"
        log_info "[DRY-RUN] Would symlink $BIN_DIR/gravlift -> $SELF_INSTALL_DIR/gravlift"
        check_path
        return 0
    fi

    self_install
    check_path
}

cmd_uninstall() {
    local target="app"
    local dry_run="false"
    local purge_mode="false"
    YES_MODE="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                print_command_help "uninstall"
                return 0
                ;;
            app|antigravity)
                target="app"
                shift
                ;;
            self|gravlift)
                target="self"
                shift
                ;;
            all|everything)
                target="all"
                shift
                ;;
            --dry-run)
                dry_run="true"
                shift
                ;;
            --purge)
                purge_mode="true"
                shift
                ;;
            -y|--yes)
                YES_MODE="true"
                shift
                ;;
            --self-install-dir)
                if [ -z "${2:-}" ]; then
                    log_error "Option $1 requires a directory path argument."
                    print_command_help "uninstall"
                    exit 1
                fi
                CLI_SELF_INSTALL_DIR="$2"
                shift 2
                ;;
            --bin-dir)
                if [ -z "${2:-}" ]; then
                    log_error "Option $1 requires a directory path argument."
                    print_command_help "uninstall"
                    exit 1
                fi
                CLI_BIN_DIR="$2"
                shift 2
                ;;
            -*)
                log_error "Unknown option for uninstall: $1"
                print_command_help "uninstall"
                exit 1
                ;;
            *)
                log_error "Unknown uninstall target: $1"
                print_command_help "uninstall"
                exit 1
                ;;
        esac
    done

    BIN_DIR=$(resolve_bin_dir)
    SELF_INSTALL_DIR=$(resolve_self_install_dir)

    case "$target" in
        app)
            uninstall_antigravity "$dry_run" "$purge_mode"
            ;;
        self)
            uninstall_self "$dry_run" "$purge_mode"
            ;;
        all)
            if [ "$dry_run" = "true" ]; then
                uninstall_antigravity "true" "$purge_mode"
                uninstall_self "true" "$purge_mode"
                return 0
            fi
            if ! confirm_action "Are you sure you want to uninstall Antigravity 2.0, gravlift, and related files?"; then
                log_info "Uninstallation canceled."
                return 0
            fi
            YES_MODE="true"
            uninstall_antigravity "false" "$purge_mode"
            uninstall_self "false" "$purge_mode"
            ;;
    esac
}

cmd_install() {
    local dry_run="false"
    local skip_backup="false"
    local force="false"
    local auto_self_install="true"
    local archives=()

    # Determine default auto self-install behavior from config or environment
    if [[ "${CONFIG_AUTO_SELF_INSTALL,,}" =~ ^(false|0|no|off)$ ]] || \
       [[ "${GRAVLIFT_AUTO_SELF_INSTALL:-}" =~ ^(false|0|no|off)$ ]] || \
       [ -n "${GRAVLIFT_NO_SELF_INSTALL:-}" ]; then
        auto_self_install="false"
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                print_command_help "install"
                return 0
                ;;
            --dry-run)
                dry_run="true"
                shift
                ;;
            --skip-backup)
                skip_backup="true"
                shift
                ;;
            --force)
                force="true"
                shift
                ;;
            --no-self-install|--no-install-self)
                auto_self_install="false"
                shift
                ;;
            --bin-dir)
                if [ -z "${2:-}" ]; then
                    log_error "Option $1 requires a directory path argument."
                    print_command_help "install"
                    exit 1
                fi
                CLI_BIN_DIR="$2"
                shift 2
                ;;
            --self-install-dir)
                if [ -z "${2:-}" ]; then
                    log_error "Option $1 requires a directory path argument."
                    print_command_help "install"
                    exit 1
                fi
                CLI_SELF_INSTALL_DIR="$2"
                shift 2
                ;;
            -*)
                log_error "Unknown option for install: $1"
                print_command_help "install"
                exit 1
                ;;
            *)
                archives+=("$1")
                shift
                ;;
        esac
    done

    BIN_DIR=$(resolve_bin_dir)
    SELF_INSTALL_DIR=$(resolve_self_install_dir)

    # Auto-detection if no archives provided
    if [ ${#archives[@]} -eq 0 ]; then
        local downloads_dir="$HOME/Downloads"
        if command -v xdg-user-dir &>/dev/null; then
            downloads_dir=$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")
        fi

        log_info "No archives specified. Scanning current directory and $downloads_dir for archives..."
        
        # Check current directory
        while IFS= read -r -d '' file; do
            if [ "$(detect_app_type "$file")" = "antigravity" ]; then
                archives+=("$file")
            fi
        done < <(find . -maxdepth 1 -type f -iname "*antigravity*.tar.gz" -print0 2>/dev/null)

        # Check Downloads directory
        if [ -d "$downloads_dir" ]; then
            while IFS= read -r -d '' file; do
                if [ "$(detect_app_type "$file")" = "antigravity" ]; then
                    archives+=("$file")
                fi
            done < <(find "$downloads_dir" -maxdepth 1 -type f -iname "*antigravity*.tar.gz" -print0 2>/dev/null)
        fi

        # Remove duplicates
        if [ ${#archives[@]} -gt 0 ]; then
            local unique_archives=()
            for arc in "${archives[@]}"; do
                local abs_arc
                abs_arc=$(realpath "$arc")
                local found=0
                for u_arc in "${unique_archives[@]:-}"; do
                    if [ "$u_arc" = "$abs_arc" ]; then
                        found=1
                        break
                    fi
                done
                if [ $found -eq 0 ]; then
                    unique_archives+=("$abs_arc")
                fi
            done
            archives=("${unique_archives[@]}")
        fi
    fi

    if [ ${#archives[@]} -eq 0 ]; then
        log_error "No Antigravity 2.0 archives (*[Aa]ntigravity*.tar.gz) found to install."
        log_info "Please provide the path to the .tar.gz archive as an argument."
        log_info "Official downloads: https://antigravity.google/download"
        print_command_help "install"
        exit 1
    fi

    log_info "Found ${#archives[@]} archive(s) to process."
    echo "-------------------------------------------------"

    # Validate archives: must be Antigravity 2.0 and at most one archive
    local antigravity_archives=()

    for archive in "${archives[@]}"; do
        if [ ! -f "$archive" ]; then
            log_error "Archive file not found: $archive"
            exit 1
        fi
        local app_type
        app_type=$(detect_app_type "$archive")
        if [ "$app_type" = "antigravity" ]; then
            antigravity_archives+=("$archive")
        else
            log_error "Could not detect Antigravity 2.0 inside archive: $(basename "$archive")"
            log_info "Make sure the file is an Antigravity 2.0 Linux archive."
            log_info "Official downloads: https://antigravity.google/download"
            exit 1
        fi
    done

    if [ ${#antigravity_archives[@]} -gt 1 ]; then
        log_error "Multiple archives found for Antigravity 2.0:"
        for arc in "${antigravity_archives[@]}"; do
            echo "  - $arc"
        done
        log_error "Installation aborted: Please specify at most one archive for Antigravity 2.0."
        exit 1
    fi

    # Pre-flight check: Disk space verification
    if [ "$dry_run" = "false" ]; then
        check_disk_space
    fi

    local success_count=0
    for archive in "${archives[@]}"; do
        if install_archive "$archive" "$dry_run" "$skip_backup" "$force"; then
            success_count=$((success_count + 1))
        fi
    done

    if [ "$dry_run" = "false" ] && [ $success_count -gt 0 ]; then
        if [ "$auto_self_install" = "true" ]; then
            log_info "Installing the 'gravlift' management tool into your PATH..."
            log_info "(Use 'gravlift' anytime to check for updates or manage Antigravity)"
            self_install
        else
            log_info "Skipping gravlift self-installation (opted out)."
        fi
    fi

    check_path

    if [ $success_count -eq ${#archives[@]} ]; then
        log_success "All operations completed successfully."
    else
        log_warning "Some installations failed ($success_count/${#archives[@]} succeeded)."
        exit 1
    fi
}

cmd_update() {
    cmd_install "$@"
}

# --- Main Entry Point & Command Dispatcher ---

main() {
    # Register trap handler for temporary files and locking cleanup
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    print_banner

    check_dependencies
    
    # Establish concurrency lock
    acquire_lock

    # Pre-flight checks
    check_glibc_version

    # Load configuration
    load_config

    # Check for empty invocation -> default to update (scans downloads)
    if [ $# -eq 0 ]; then
        cmd_update
        return 0
    fi

    # Check for top-level subcommands
    case "$1" in
        install)
            shift
            cmd_install "$@"
            return 0
            ;;
        update)
            shift
            cmd_update "$@"
            return 0
            ;;
        self-install)
            shift
            cmd_self_install "$@"
            return 0
            ;;
        uninstall)
            shift
            cmd_uninstall "$@"
            return 0
            ;;
        check)
            shift
            cmd_check "$@"
            return 0
            ;;
        version)
            cmd_version
            return 0
            ;;
        help)
            shift
            cmd_help "$@"
            return 0
            ;;
    esac

    # Backward compatibility: Parse legacy flags and options
    local dry_run="false"
    local skip_backup="false"
    local force="false"
    local self_install_only="false"
    local auto_self_install="true"
    local uninstall_mode=""
    local purge_mode="false"
    YES_MODE="false"
    local archives=()

    # Determine default auto self-install behavior from config or environment
    if [[ "${CONFIG_AUTO_SELF_INSTALL,,}" =~ ^(false|0|no|off)$ ]] || \
       [[ "${GRAVLIFT_AUTO_SELF_INSTALL:-}" =~ ^(false|0|no|off)$ ]] || \
       [ -n "${GRAVLIFT_NO_SELF_INSTALL:-}" ]; then
        auto_self_install="false"
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                print_usage
                exit 0
                ;;
            -v|--version)
                cmd_version
                exit 0
                ;;
            --dry-run)
                dry_run="true"
                shift
                ;;
            --skip-backup)
                skip_backup="true"
                shift
                ;;
            --force)
                force="true"
                shift
                ;;
            --self-install|--install-self)
                self_install_only="true"
                shift
                ;;
            --no-self-install|--no-install-self)
                auto_self_install="false"
                shift
                ;;
            --uninstall)
                uninstall_mode="app"
                shift
                ;;
            --uninstall-self)
                uninstall_mode="self"
                shift
                ;;
            --uninstall-all)
                uninstall_mode="all"
                shift
                ;;
            --purge)
                purge_mode="true"
                shift
                ;;
            -y|--yes)
                YES_MODE="true"
                shift
                ;;
            --self-install-dir)
                if [ -z "${2:-}" ]; then
                    log_error "Option $1 requires a directory path argument."
                    print_usage
                    exit 1
                fi
                CLI_SELF_INSTALL_DIR="$2"
                shift 2
                ;;
            --bin-dir)
                if [ -z "${2:-}" ]; then
                    log_error "Option $1 requires a directory path argument."
                    print_usage
                    exit 1
                fi
                CLI_BIN_DIR="$2"
                shift 2
                ;;
            -*)
                log_error "Unknown option: $1"
                print_usage
                exit 1
                ;;
            *)
                archives+=("$1")
                shift
                ;;
        esac
    done

    # Route legacy mode flags to subcommand handlers
    if [ -n "$uninstall_mode" ]; then
        local uninstall_args=("$uninstall_mode")
        [ "$dry_run" = "true" ] && uninstall_args+=("--dry-run")
        [ "$purge_mode" = "true" ] && uninstall_args+=("--purge")
        [ "$YES_MODE" = "true" ] && uninstall_args+=("-y")
        cmd_uninstall "${uninstall_args[@]}"
        return 0
    fi

    if [ "$self_install_only" = "true" ]; then
        local self_args=()
        [ "$dry_run" = "true" ] && self_args+=("--dry-run")
        cmd_self_install "${self_args[@]}"
        return 0
    fi

    # Forward remaining options & archives to cmd_install
    local install_args=()
    [ "$dry_run" = "true" ] && install_args+=("--dry-run")
    [ "$skip_backup" = "true" ] && install_args+=("--skip-backup")
    [ "$force" = "true" ] && install_args+=("--force")
    [ "$auto_self_install" = "false" ] && install_args+=("--no-self-install")
    if [ ${#archives[@]} -gt 0 ]; then
        install_args+=("${archives[@]}")
    fi

    cmd_install "${install_args[@]}"
}

main "$@"
