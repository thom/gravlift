#!/usr/bin/env bash

# gravlift - Smart Installer and Update Manager for Antigravity 2.0
# Installs application binaries in ~/opt, manages symlinks in ~/.local/bin,
# and configures GNOME desktop entries.

set -euo pipefail
umask 022

# --- Color Scheme & Typography ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# --- Paths & Configuration ---
INSTALL_PARENT="${INSTALL_PARENT:-$HOME/opt}"
BIN_DIR=""
SELF_INSTALL_DIR=""
DESKTOP_DIR="$HOME/.local/share/applications"
BACKUP_DIR="$HOME/.cache/gravlift/backups"
GRAVLIFT_VERSION="2.0.2"

CLI_BIN_DIR=""
CLI_SELF_INSTALL_DIR=""
CONFIG_BIN_DIR=""
CONFIG_SELF_INSTALL_DIR=""
CONFIG_AUTO_SELF_INSTALL=""

# Load optional configuration file (~/.config/gravlift/config)
load_config() {
    local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/gravlift/config"
    if [ -f "$config_file" ]; then
        while IFS='=' read -r key value || [ -n "$key" ]; do
            key=$(echo "$key" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            [[ -z "$key" || "$key" =~ ^# ]] && continue
            value=$(echo "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^["'"'"']//' -e 's/["'"'"']$//')

            if [[ "$value" == "~"* ]]; then
                value="$HOME${value#\~}"
            fi

            case "$key" in
                SELF_INSTALL_DIR|self_install_dir)
                    CONFIG_SELF_INSTALL_DIR="$value"
                    ;;
                BIN_DIR|bin_dir)
                    CONFIG_BIN_DIR="$value"
                    ;;
                INSTALL_PARENT|install_parent)
                    INSTALL_PARENT="$value"
                    ;;
                AUTO_SELF_INSTALL|auto_self_install|SELF_INSTALL|self_install)
                    CONFIG_AUTO_SELF_INSTALL="$value"
                    ;;
            esac
        done < "$config_file"
    fi
}

# Resolve the directory for executable symlinks
resolve_bin_dir() {
    if [ -n "${CLI_BIN_DIR:-}" ]; then
        echo "$CLI_BIN_DIR"
        return 0
    fi
    if [ -n "${CONFIG_BIN_DIR:-}" ]; then
        echo "$CONFIG_BIN_DIR"
        return 0
    fi
    if [ -n "${GRAVLIFT_BIN_DIR:-}" ]; then
        echo "$GRAVLIFT_BIN_DIR"
        return 0
    fi
    if [ -n "${XDG_BIN_HOME:-}" ]; then
        echo "$XDG_BIN_HOME"
        return 0
    fi
    if command -v systemd-path &>/dev/null; then
        local sys_bin
        sys_bin=$(systemd-path user-binaries 2>/dev/null) || sys_bin=""
        if [ -n "$sys_bin" ]; then
            echo "$sys_bin"
            return 0
        fi
    fi
    echo "$HOME/.local/bin"
}

# Resolve the installation directory for gravlift itself
resolve_self_install_dir() {
    if [ -n "${CLI_SELF_INSTALL_DIR:-}" ]; then
        echo "$CLI_SELF_INSTALL_DIR"
        return 0
    fi
    if [ -n "${CONFIG_SELF_INSTALL_DIR:-}" ]; then
        echo "$CONFIG_SELF_INSTALL_DIR"
        return 0
    fi
    if [ -n "${GRAVLIFT_INSTALL_DIR:-}" ]; then
        echo "$GRAVLIFT_INSTALL_DIR"
        return 0
    fi
    echo "$INSTALL_PARENT/gravlift"
}

# --- Global State for Cleanup & Locking ---
TEMP_DIRS=()
LOCK_DIR_PATH=""
LOCK_FILE_PATH=""

register_temp_dir() {
    TEMP_DIRS+=("$1")
}

cleanup() {
    release_lock
    
    local dir_exists=0
    for dir in "${TEMP_DIRS[@]:-}"; do
        if [ -d "$dir" ]; then
            dir_exists=1
            break
        fi
    done

    if [ "$dir_exists" -eq 1 ]; then
        log_info "Cleaning up temporary directories..."
        for dir in "${TEMP_DIRS[@]:-}"; do
            if [ -d "$dir" ]; then
                rm -rf "$dir"
            fi
        done
    fi
}

acquire_lock() {
    local cache_dir="$HOME/.cache/gravlift"
    LOCK_DIR_PATH="$cache_dir/gravlift.lock.dir"
    LOCK_FILE_PATH="$LOCK_DIR_PATH/pid"
    
    mkdir -p "$cache_dir"
    
    # Atomically create the lock directory
    while ! mkdir "$LOCK_DIR_PATH" 2>/dev/null; do
        local old_pid=""
        if [ -f "$LOCK_FILE_PATH" ]; then
            old_pid=$(cat "$LOCK_FILE_PATH" 2>/dev/null) || old_pid=""
        fi
        
        # Check if the process in the lock file is still running
        if [ -n "$old_pid" ] && kill -0 "$old_pid" &>/dev/null; then
            log_error "Another instance of gravlift (PID $old_pid) is currently running."
            log_error "Please wait for it to finish or terminate it to avoid file corruption."
            # Clear LOCK_DIR_PATH so release_lock() doesn't remove the active lock
            LOCK_DIR_PATH=""
            LOCK_FILE_PATH=""
            exit 1
        else
            log_warning "Stale lock found. Removing stale lock directory."
            rm -rf "$LOCK_DIR_PATH"
        fi
    done
    
    # Write current PID to lock file inside the directory
    echo "$$" > "$LOCK_FILE_PATH"
}

release_lock() {
    if [ -n "${LOCK_DIR_PATH:-}" ] && [ -d "$LOCK_DIR_PATH" ]; then
        local current_pid=""
        if [ -f "$LOCK_FILE_PATH" ]; then
            current_pid=$(cat "$LOCK_FILE_PATH" 2>/dev/null) || current_pid=""
        fi
        if [ "$current_pid" = "$$" ]; then
            rm -rf "$LOCK_DIR_PATH"
        fi
    fi
}

