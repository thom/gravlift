#!/usr/bin/env bash

# gravlift - Smart Installer and Update Manager for Antigravity 2.0 & Antigravity IDE
# Installs application binaries in ~/opt, manages symlinks in ~/.local/bin,
# and configures GNOME desktop entries.

set -euo pipefail
umask 022

# --- Color Scheme & Typography ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# --- Paths & Configuration ---
INSTALL_PARENT="$HOME/opt"
BIN_DIR="$HOME/.local/bin"
DESKTOP_DIR="$HOME/.local/share/applications"
BACKUP_DIR="$HOME/.cache/gravlift/backups"
GRAVLIFT_VERSION="1.0.0"

# --- Global State for Cleanup & Locking ---
TEMP_DIRS=()
LOCK_DIR_PATH=""
LOCK_FILE_PATH=""

register_temp_dir() {
    TEMP_DIRS+=("$1")
}

cleanup() {
    release_lock
    
    local dir_exists=0
    for dir in "${TEMP_DIRS[@]:-}"; do
        if [ -d "$dir" ]; then
            dir_exists=1
            break
        fi
    done

    if [ "$dir_exists" -eq 1 ]; then
        log_info "Cleaning up temporary directories..."
        for dir in "${TEMP_DIRS[@]:-}"; do
            if [ -d "$dir" ]; then
                rm -rf "$dir"
            fi
        done
    fi
}

acquire_lock() {
    local cache_dir="$HOME/.cache/gravlift"
    LOCK_DIR_PATH="$cache_dir/gravlift.lock.dir"
    LOCK_FILE_PATH="$LOCK_DIR_PATH/pid"
    
    mkdir -p "$cache_dir"
    
    # Atomically create the lock directory
    while ! mkdir "$LOCK_DIR_PATH" 2>/dev/null; do
        local old_pid=""
        if [ -f "$LOCK_FILE_PATH" ]; then
            old_pid=$(cat "$LOCK_FILE_PATH" 2>/dev/null) || old_pid=""
        fi
        
        # Check if the process in the lock file is still running
        if [ -n "$old_pid" ] && kill -0 "$old_pid" &>/dev/null; then
            log_error "Another instance of gravlift (PID $old_pid) is currently running."
            log_error "Please wait for it to finish or terminate it to avoid file corruption."
            # Clear LOCK_DIR_PATH so release_lock() doesn't remove the active lock
            LOCK_DIR_PATH=""
            LOCK_FILE_PATH=""
            exit 1
        else
            log_warning "Stale lock found. Removing stale lock directory."
            rm -rf "$LOCK_DIR_PATH"
        fi
    done
    
    # Write current PID to lock file inside the directory
    echo "$$" > "$LOCK_FILE_PATH"
}

release_lock() {
    if [ -n "${LOCK_DIR_PATH:-}" ] && [ -d "$LOCK_DIR_PATH" ]; then
        local current_pid=""
        if [ -f "$LOCK_FILE_PATH" ]; then
            current_pid=$(cat "$LOCK_FILE_PATH" 2>/dev/null) || current_pid=""
        fi
        if [ "$current_pid" = "$$" ]; then
            rm -rf "$LOCK_DIR_PATH"
        fi
    fi
}

# Print banner
print_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "      _____                 _      _  __ _   "
    echo "     / ____|               | |    (_)/ _| |  "
    echo "    | |  __ _ __ __ ___   _| |     _| |_| |_ "
    echo "    | | |_ | '__/ _\` \ \ / / |    | |  _| __|"
    echo "    | |__| | | | (_| |\ V /| |____| | | | |_ "
    echo "     \_____|_|  \__,_| \_/ |______|_|_|  \__|"
    echo -e "  Antigravity 2.0 & IDE Linux Installer/Updater v${GRAVLIFT_VERSION}${NC}"
    echo "================================================="
}

# Print usage
print_usage() {
    echo "Usage: $(basename "$0") [options] [archive1.tar.gz] [archive2.tar.gz]..."
    echo
    echo "Options:"
    echo "  -h, --help       Show this help message"
    echo "  -v, --version    Show script version"
    echo "  --dry-run        Simulate the installation without modifying files"
    echo "  --skip-backup    Skip creating a backup of existing installations"
    echo "  --force          Force installation even if archive version is not newer"
    echo
    echo "If no archives are provided, the script scans the current directory"
    echo "and ~/Downloads for files matching *antigravity*.tar.gz."
    echo
    echo "Note: Running this script will also register itself as 'gravlift'"
    echo "in ~/.local/bin for future use."
}

# Logger utilities
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Dependency check
check_dependencies() {
    local missing=()
    for cmd in tar find cut uniq mktemp ln rm cp realpath; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done
    if [ ${#missing[@]} -ne 0 ]; then
        log_error "Missing required command dependencies: ${missing[*]}"
        exit 1
    fi
}

# Detect app type inside a tarball
detect_app_type() {
    local tarball="$1"
    
    # Method 1: Inspect archive contents (single execution)
    local contents
    if contents=$(tar -tf "$tarball" 2>/dev/null); then
        # Check for antigravity-ide binary
        if echo "$contents" | grep -qE "(^|/)antigravity-ide$"; then
            echo "ide"
            return 0
        fi
        # Check for antigravity binary (standard 2.0)
        if echo "$contents" | grep -qE "(^|/)antigravity$"; then
            echo "antigravity"
            return 0
        fi
    fi

    # Method 2: Fallback to filename matching
    local filename
    filename=$(basename "$tarball" | tr '[:upper:]' '[:lower:]')
    if [[ "$filename" =~ ide ]]; then
        echo "ide"
    elif [[ "$filename" =~ antigravity ]]; then
        echo "antigravity"
    else
        echo "unknown"
    fi
}

# Search for a suitable icon file in the app directory
find_app_icon() {
    local dir="$1"
    local app_name="$2"
    local alt_name="$3"
    local icon_path=""

    # Helper function to find files excluding dependency folders (node_modules, extensions)
    find_pruned() {
        local search_dir="$1"
        local pat1="$2"
        local pat2="$3"
        find "$search_dir" \
            -path "*/node_modules" -prune \
            -o -path "*/extensions" -prune \
            -o -type f \( -name "$pat1" -o -name "$pat2" \) -print -quit
    }

    # 1. Search for PNG/SVG files with the app name (excluding node_modules/extensions)
    icon_path=$(find_pruned "$dir" "*${app_name}*.png" "*${app_name}*.svg")
    
    # 2. Search for PNG/SVG files with the alt name (e.g. code) (excluding node_modules/extensions)
    if [ -z "$icon_path" ] && [ -n "$alt_name" ]; then
        icon_path=$(find_pruned "$dir" "*${alt_name}*.png" "*${alt_name}*.svg")
    fi

    # 3. Search for generic icon/logo names (excluding node_modules/extensions)
    if [ -z "$icon_path" ]; then
        icon_path=$(find_pruned "$dir" "*icon*.png" "*icon*.svg")
    fi
    if [ -z "$icon_path" ]; then
        icon_path=$(find_pruned "$dir" "*logo*.png" "*logo*.svg")
    fi

    # 4. Search for any PNG/SVG files inside resources folder
    if [ -z "$icon_path" ] && [ -d "$dir/resources" ]; then
        icon_path=$(find "$dir/resources" -type f \( -name "*.png" -o -name "*.svg" \) -print -quit)
    fi

    # 5. Search for any PNG/SVG files in the entire target directory (excluding node_modules/extensions)
    if [ -z "$icon_path" ]; then
        icon_path=$(find_pruned "$dir" "*.png" "*.svg")
    fi

    echo "$icon_path"
}

# Create desktop file
create_desktop_launcher() {
    local app_type="$1"
    local app_dir="$2"
    local exec_path="$3"
    local icon_path="$4"
    local desktop_file=""
    local icon_name="antigravity"

    if [ "$app_type" = "ide" ]; then
        icon_name="antigravity-ide"
    fi

    mkdir -p "$DESKTOP_DIR"
    local local_icon_dir="$HOME/.local/share/icons"

    if [ -n "$icon_path" ] && [ -f "$icon_path" ]; then
        mkdir -p "$local_icon_dir"
        local filename
        filename=$(basename "$icon_path")
        local ext=""
        if [[ "$filename" == *.* ]]; then
            ext="${filename##*.}"
        fi
        
        local dest_icon
        if [ -n "$ext" ]; then
            dest_icon="$local_icon_dir/$icon_name.$ext"
        else
            dest_icon="$local_icon_dir/$icon_name.png"
        fi
        cp "$icon_path" "$dest_icon"
    else
        # Fallback icon name if no custom icon found
        icon_name="system-run"
    fi

    if [ "$app_type" = "ide" ]; then
        desktop_file="$DESKTOP_DIR/antigravity-ide.desktop"
        log_info "Creating desktop launcher: $desktop_file"
        cat > "$desktop_file" <<EOF
[Desktop Entry]
Name=Antigravity IDE
Comment=Google Antigravity Development Environment
Exec="$exec_path" %U
Terminal=false
Type=Application
Icon=$icon_name
Categories=Development;IDE;
StartupNotify=true
StartupWMClass=Antigravity-IDE
EOF
    else
        desktop_file="$DESKTOP_DIR/antigravity.desktop"
        log_info "Creating desktop launcher: $desktop_file"
        cat > "$desktop_file" <<EOF
[Desktop Entry]
Name=Antigravity 2.0
Comment=Google Antigravity Agent Orchestrator
Exec="$exec_path" %U
Terminal=false
Type=Application
Icon=$icon_name
Categories=Development;
StartupNotify=true
StartupWMClass=Antigravity
EOF
    fi
    
    # Update GNOME desktop entry database
    if command -v update-desktop-database &>/dev/null; then
        update-desktop-database "$DESKTOP_DIR" || true
    fi
}

# Returns 0 if $1 <= $2, 1 otherwise (semantic version comparison using sort -V)
version_le() {
    if [ "$1" = "$2" ]; then
        return 0
    fi
    local sorted
    sorted=$(printf '%s\n%s\n' "$1" "$2" | sort -V)
    local first_line
    read -r first_line <<< "$sorted"
    if [ "$first_line" = "$1" ]; then
        return 0
    else
        return 1
    fi
}

# Get application version from package.json or product.json in target directory
get_app_version() {
    local app_dir="$1"
    local app_type="$2"
    local exe_name="$3"
    
    local pkg_json=""
    
    # 1. Search for package.json or product.json in standard locations
    if [ -f "$app_dir/resources/app/package.json" ]; then
        pkg_json="$app_dir/resources/app/package.json"
    elif [ -f "$app_dir/resources/app/product.json" ]; then
        pkg_json="$app_dir/resources/app/product.json"
    fi
    
    if [ -n "$pkg_json" ]; then
        # Extract version using sed (portable, avoids pipefail/SIGPIPE issues)
        sed -n '/"version":/ { s/.*"version":\s*"//; s/".*//; p; q; }' "$pkg_json" || echo "0.0.0"
    else
        # 2. Try executing the binary inside Electron's Node environment to read package.json inside app.asar
        local exe_path="$app_dir/$exe_name"
        if [ -f "$exe_path" ]; then
            local ver
            ver=$(ELECTRON_RUN_AS_NODE=true "$exe_path" -e "
                try {
                    console.log(require(process.argv[1]).version);
                } catch(e) {
                    try {
                        console.log(require(process.argv[2]).version);
                    } catch(err) {
                        console.log('0.0.0');
                    }
                }
            " "$app_dir/resources/app.asar/package.json" "$app_dir/resources/app/package.json" 2>/dev/null) || ver="0.0.0"
            echo "${ver:-0.0.0}"
        else
            echo "0.0.0"
        fi
    fi
}

# Perform installation for a single archive
install_archive() {
    local tarball="$1"
    local dry_run="$2"
    local skip_backup="$3"
    local force="$4"

    if [ ! -f "$tarball" ]; then
        log_error "Archive file not found: $tarball"
        return 1
    fi

    log_info "Analyzing archive: $(basename "$tarball")..."
    local app_type
    app_type=$(detect_app_type "$tarball")

    if [ "$app_type" = "unknown" ]; then
        log_error "Could not determine the application type for archive: $tarball"
        log_error "Make sure the file is either Antigravity 2.0 or Antigravity IDE."
        return 1
    fi

    local app_label="Antigravity 2.0"
    local folder_name="antigravity"
    local exec_name="antigravity"
    if [ "$app_type" = "ide" ]; then
        app_label="Antigravity IDE"
        folder_name="antigravity-ide"
        exec_name="antigravity-ide"
    fi

    log_info "Detected application: ${BOLD}$app_label${NC}"

    local target_dir="$INSTALL_PARENT/$folder_name"
    local bin_link="$BIN_DIR/$exec_name"

    # --- Dry Run Short Circuit ---
    if [ "$dry_run" = "true" ]; then
        log_info "[DRY-RUN] Would extract $(basename "$tarball"), compare versions, backup, clean, and install to $target_dir"
        log_info "[DRY-RUN] Would symlink $target_dir/$exec_name -> $bin_link"
        log_info "[DRY-RUN] Would generate GNOME desktop entry."
        return 0
    fi

    # --- 1. Extract to Temporary Folder for Analysis ---
    log_info "Extracting archive contents to temporary directory..."
    local temp_extract_dir
    temp_extract_dir=$(mktemp -d)
    register_temp_dir "$temp_extract_dir"
    
    # Disable error exit momentarily to clean up properly if extraction fails
    set +e
    tar -xzf "$tarball" -C "$temp_extract_dir"
    local extract_exit=$?
    set -e
    
    if [ $extract_exit -ne 0 ]; then
        log_error "Failed to extract tarball archive."
        rm -rf "$temp_extract_dir"
        return 1
    fi

    # Find the actual executable location in the extracted files (picking the shallowest path to avoid bin/ scripts)
    local found_exe=""
    local min_depth=999
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local slashes="${line//[^\/]}"
        local depth="${#slashes}"
        if [ "$depth" -lt "$min_depth" ]; then
            min_depth="$depth"
            found_exe="$line"
        fi
    done < <(find "$temp_extract_dir" -type f -name "$exec_name")
    
    if [ -z "$found_exe" ]; then
        log_error "Could not find the executable '$exec_name' inside the archive."
        rm -rf "$temp_extract_dir"
        return 1
    fi
    
    # Determine the root of the app inside the archive
    local app_src_root
    app_src_root=$(dirname "$found_exe")

    # --- 2. Version Comparison Check ---
    local new_version
    new_version=$(get_app_version "$app_src_root" "$app_type" "$exec_name")
    
    local installed_version="0.0.0"
    if [ -d "$target_dir" ]; then
        installed_version=$(get_app_version "$target_dir" "$app_type" "$exec_name")
    fi

    log_info "Archive version: ${BOLD}$new_version${NC}"
    if [ "$installed_version" != "0.0.0" ]; then
        log_info "Currently installed version: ${BOLD}$installed_version${NC}"
        
        if version_le "$new_version" "$installed_version"; then
            if [ "$force" = "true" ]; then
                log_warning "Archive version ($new_version) is not newer than installed version ($installed_version), but forcing installation as requested."
            else
                log_error "Archive version ($new_version) is not newer than installed version ($installed_version)."
                log_error "To overwrite, upgrade/downgrade anyway, run with the --force option."
                rm -rf "$temp_extract_dir"
                return 1
            fi
        fi
    fi

    # --- 3. Backup Existing Installation ---
    if [ -d "$target_dir" ] && [ "$skip_backup" = "false" ]; then
        local timestamp
        timestamp=$(date +%Y%m%d_%H%M%S)
        local backup_file="$BACKUP_DIR/${folder_name}_backup_${timestamp}.tar.gz"
        log_info "Existing installation found. Creating backup..."
        mkdir -p "$BACKUP_DIR"
        
        if tar -czf "$backup_file" -C "$INSTALL_PARENT" "$folder_name"; then
            log_success "Backup saved to: $backup_file"
        else
            log_warning "Failed to create backup, but proceeding with installation."
        fi
    fi

    # --- 4. Clean and Extract (Atomic Swap) ---
    local temp_target="${target_dir}.new"
    register_temp_dir "$temp_target"
    rm -rf "$temp_target"
    mkdir -p "$temp_target"

    log_info "Installing new version files..."
    # Move all files safely using POSIX-compatible find/exec sh
    find "$app_src_root" -mindepth 1 -maxdepth 1 -exec sh -c 'mv "$@" "$0"' "$temp_target" {} +
    
    # Clean up temporary extraction directory
    rm -rf "$temp_extract_dir"

    log_info "Replacing old installation with new version..."
    if [ -d "$target_dir" ]; then
        local old_target="${target_dir}.old"
        register_temp_dir "$old_target"
        rm -rf "$old_target"
        mv "$target_dir" "$old_target"
        mv "$temp_target" "$target_dir"
        rm -rf "$old_target"
    else
        mv "$temp_target" "$target_dir"
    fi

    # --- 5. Symlinks ---
    log_info "Creating command-line symlink..."
    mkdir -p "$BIN_DIR"
    rm -f "$bin_link"
    ln -s "$target_dir/$exec_name" "$bin_link"
    log_success "Symlink created at: $bin_link"

    # --- 6. Icons and Desktop Launcher ---
    local icon_path=""
    icon_path=$(find_app_icon "$target_dir" "$exec_name" "code")
    
    if [ -z "$icon_path" ]; then
        # Check if we can extract it from app.asar (for packaged Electron apps)
        local asar_file="$target_dir/resources/app.asar"
        if [ -f "$asar_file" ]; then
            local local_icon_dir="$HOME/.local/share/icons"
            mkdir -p "$local_icon_dir"
            log_info "Icon not found on disk. Extracting icon.png from app.asar..."
            
            ELECTRON_RUN_AS_NODE=true "$target_dir/$exec_name" -e "
                const fs = require('fs');
                try {
                    fs.copyFileSync(process.argv[1], process.argv[2]);
                    console.log('SUCCESS');
                } catch(e) {}
            " "$asar_file" "$local_icon_dir/antigravity.png" &>/dev/null || true
            
            if [ -f "$local_icon_dir/antigravity.png" ]; then
                icon_path="$local_icon_dir/antigravity.png"
            fi
        fi
    fi

    if [ -n "$icon_path" ]; then
        log_info "Found application icon at: $icon_path"
    else
        log_warning "Could not find a suitable icon file. Using system default icon."
    fi
    create_desktop_launcher "$app_type" "$target_dir" "$bin_link" "$icon_path"

    log_success "$app_label installed/updated successfully!"
    echo "-------------------------------------------------"
}

# Verify Path
check_path() {
    if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
        log_warning "${BOLD}~/.local/bin${NC} is not currently in your ${BOLD}\$PATH${NC}."
        echo "To run 'antigravity' or 'antigravity-ide' from the terminal:"
        echo
        echo -e "For ${BOLD}bash${NC} or ${BOLD}zsh${NC}, add this to your config file (e.g. ~/.bashrc or ~/.zshrc):"
        echo -e "${YELLOW}  export PATH=\"\$HOME/.local/bin:\$PATH\"${NC}"
        echo
        echo -e "For ${BOLD}fish${NC}, run this command once to persist the path dynamically:"
        echo -e "${YELLOW}  fish_add_path \$HOME/.local/bin${NC}"
        echo "Or add this to ~/.config/fish/config.fish:"
        echo -e "${YELLOW}  set -gx PATH \$HOME/.local/bin \$PATH${NC}"
        echo
    else
        log_success "~/.local/bin is already in your \$PATH."
    fi
}

# Install this script itself to ~/.local/bin/gravlift
self_install() {
    local script_target="$BIN_DIR/gravlift"
    mkdir -p "$BIN_DIR"
    
    # Only copy if we are not already running from the target path
    local current_script_abs
    current_script_abs=$(realpath "$0")
    local target_script_abs
    if [ -f "$script_target" ]; then
        target_script_abs=$(realpath "$script_target")
    else
        target_script_abs=""
    fi

    if [ "$current_script_abs" != "$target_script_abs" ]; then
        log_info "Registering 'gravlift' script to ~/.local/bin..."
        cp "$0" "$script_target"
        chmod +x "$script_target"
        log_success "Script registered. You can now run 'gravlift' from anywhere!"
    fi
}

# Verify that the system glibc version meets requirements (>= 2.28)
check_glibc_version() {
    if ! command -v ldd &>/dev/null; then
        log_warning "Could not find 'ldd' to verify glibc compatibility."
        return 0
    fi
    
    local ldd_output
    ldd_output=$(ldd --version | head -n 1) || return 0
    
    # Extract version e.g. "2.35"
    local glibc_ver
    glibc_ver=$(echo "$ldd_output" | grep -oE '[0-9]+\.[0-9]+' | head -n 1) || return 0
    
    if [ -n "$glibc_ver" ]; then
        log_info "Detected system glibc version: ${BOLD}$glibc_ver${NC}"
        
        if version_le "$glibc_ver" "2.27"; then
            log_warning "Your system's glibc version ($glibc_ver) is below the recommended version (2.28)."
            log_warning "Antigravity applications may fail to launch at runtime."
            echo
        fi
    fi
}

# Pre-flight check: Verify available disk space in destination partition
check_disk_space() {
    local check_dir="$INSTALL_PARENT"
    # Find closest existing parent directory to check space on the correct partition
    while [ ! -d "$check_dir" ] && [ "$check_dir" != "/" ]; do
        check_dir=$(dirname "$check_dir")
    done
    
    if ! command -v df &>/dev/null; then
        log_warning "Could not find 'df' to verify available disk space."
        return 0
    fi

    local avail_kb
    avail_kb=$(df -k "$check_dir" | tail -n 1 | awk '{print $4}') || avail_kb=""
    
    if [ -n "$avail_kb" ]; then
        if [[ "$avail_kb" =~ ^[0-9]+$ ]]; then
            # Require at least 1GB (1048576 KB)
            local min_kb=1048576
            if [ "$avail_kb" -lt "$min_kb" ]; then
                log_error "Insufficient disk space on target partition containing $check_dir."
                log_error "Available: $((avail_kb / 1024)) MB, Required: 1024 MB."
                exit 1
            fi
            log_info "Disk space check passed: $((avail_kb / 1024)) MB available."
        else
            log_warning "Could not parse available disk space value: '$avail_kb'. Skipping space check."
        fi
    fi
}

main() {
    # Register trap handler for temporary files and locking cleanup
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    print_banner

    check_dependencies
    
    # Establish concurrency lock
    acquire_lock

    # Pre-flight checks
    check_glibc_version

    local dry_run="false"
    local skip_backup="false"
    local force="false"
    local archives=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                print_usage
                exit 0
                ;;
            -v|--version)
                echo "gravlift v${GRAVLIFT_VERSION}"
                exit 0
                ;;
            --dry-run)
                dry_run="true"
                shift
                ;;
            --skip-backup)
                skip_backup="true"
                shift
                ;;
            --force)
                force="true"
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                print_usage
                exit 1
                ;;
            *)
                archives+=("$1")
                shift
                ;;
        esac
    done

    # Auto-detection if no archives provided
    if [ ${#archives[@]} -eq 0 ]; then
        local downloads_dir="$HOME/Downloads"
        if command -v xdg-user-dir &>/dev/null; then
            downloads_dir=$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")
        fi

        log_info "No archives specified. Scanning current directory and $downloads_dir for archives..."
        
        # Check current directory
        while IFS= read -r -d '' file; do
            archives+=("$file")
        done < <(find . -maxdepth 1 -type f -iname "*antigravity*.tar.gz" -print0 2>/dev/null)

        # Check Downloads directory
        if [ -d "$downloads_dir" ]; then
            while IFS= read -r -d '' file; do
                archives+=("$file")
            done < <(find "$downloads_dir" -maxdepth 1 -type f -iname "*antigravity*.tar.gz" -print0 2>/dev/null)
        fi

        # Remove duplicates
        if [ ${#archives[@]} -gt 0 ]; then
            local unique_archives=()
            for arc in "${archives[@]}"; do
                local abs_arc
                abs_arc=$(realpath "$arc")
                local found=0
                for u_arc in "${unique_archives[@]:-}"; do
                    if [ "$u_arc" = "$abs_arc" ]; then
                        found=1
                        break
                    fi
                done
                if [ $found -eq 0 ]; then
                    unique_archives+=("$abs_arc")
                fi
            done
            archives=("${unique_archives[@]}")
        fi
    fi

    if [ ${#archives[@]} -eq 0 ]; then
        log_error "No Antigravity archives (*[Aa]ntigravity*.tar.gz) found to install."
        log_info "Please provide the path to the .tar.gz archive(s) as arguments."
        print_usage
        exit 1
    fi

    log_info "Found ${#archives[@]} archive(s) to process."
    echo "-------------------------------------------------"

    # Uniqueness check: at most one of each application type
    local ide_archives=()
    local antigravity_archives=()

    for archive in "${archives[@]}"; do
        if [ ! -f "$archive" ]; then
            log_error "Archive file not found: $archive"
            exit 1
        fi
        local app_type
        app_type=$(detect_app_type "$archive")
        if [ "$app_type" = "ide" ]; then
            ide_archives+=("$archive")
        elif [ "$app_type" = "antigravity" ]; then
            antigravity_archives+=("$archive")
        else
            log_error "Could not determine the application type for archive: $archive"
            exit 1
        fi
    done

    local has_error=0
    if [ ${#ide_archives[@]} -gt 1 ]; then
        log_error "Multiple archives found for Antigravity IDE:"
        for arc in "${ide_archives[@]}"; do
            echo "  - $arc"
        done
        has_error=1
    fi

    if [ ${#antigravity_archives[@]} -gt 1 ]; then
        log_error "Multiple archives found for Antigravity 2.0:"
        for arc in "${antigravity_archives[@]}"; do
            echo "  - $arc"
        done
        has_error=1
    fi

    if [ $has_error -eq 1 ]; then
        log_error "Installation aborted: Please specify at most one archive for each application."
        exit 1
    fi

    # Pre-flight check: Disk space verification
    if [ "$dry_run" = "false" ]; then
        check_disk_space
    fi

    local success_count=0
    for archive in "${archives[@]}"; do
        if install_archive "$archive" "$dry_run" "$skip_backup" "$force"; then
            success_count=$((success_count + 1))
        fi
    done

    if [ "$dry_run" = "false" ] && [ $success_count -gt 0 ]; then
        self_install
    fi

    check_path

    if [ $success_count -eq ${#archives[@]} ]; then
        log_success "All operations completed successfully."
    else
        log_warning "Some installations failed ($success_count/${#archives[@]} succeeded)."
        exit 1
    fi
}

main "$@"
